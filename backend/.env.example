# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Database (for PythonAnywhere)
DB_NAME=YOUR_USERNAME$gaming_bot
DB_USER=YOUR_USERNAME
DB_PASSWORD=your-mysql-password
DB_HOST=YOUR_USERNAME.mysql.pythonanywhere-services.com

# JWT
JWT_SECRET=your-jwt-secret-key-here

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# CORS (add your Vercel URL)
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# Allowed Hosts
ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com,localhost,127.0.0.1
